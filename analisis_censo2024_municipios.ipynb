    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "from IPython.display import display\n",
    "\n",
    "carpeta_exportaciones = Path(\"exportaciones\")\n",
    "carpeta_exportaciones.mkdir(exist_ok=True)\n",
    "contador_tablas = 0\n",
    "\n",
    "def mostrar_y_exportar_tabla(tabla, nombre):\n",
    "    global contador_tablas\n",
    "    contador_tablas += 1\n",
    "    base = f\"{contador_tablas:02d}_{nombre}\"\n",
    "    tabla.to_csv(carpeta_exportaciones / f\"{base}.csv\", encoding=\"utf-8-sig\")\n",
    "    display(tabla)\n",
    "\n",
    "p = Path(\"municipios_bolivia_censo2024_reducido.csv\")\n",
    "df = pd.read_csv(p, encoding=\"utf-8-sig\")\n",
    "print(df.shape)\n",
    "mostrar_y_exportar_tabla(df.head(), \"muestra_datos\")"
